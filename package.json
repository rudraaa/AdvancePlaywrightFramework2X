{
  "name": "advanceplaywrightframework2x",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:debug": "playwright test --debug",
    "test:e2e": "playwright test --grep @e2e",
    "test:p0": "playwright test --grep @p0",
    "test:p1": "playwright test --grep @p1",
    "test:report": "playwright show-report",
    "test:report:ci": "playwright show-report --host 0.0.0.0 --port 9323",
    "test:allure": "allure generate ./allure-results --clean -o ./allure-report && allure open ./allure-report",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "build": "tsc",
    "clean": "rm -rf dist playwright-report test-results allure-results allure-report node_modules/.cache",
    "cucumber": "cucumber-js",
    "cucumber:level0": "cucumber-js --profile level0",
    "cucumber:level1": "cucumber-js --profile level1",
    "cucumber:level2": "cucumber-js --profile level2",
    "cucumber:datatable": "cucumber-js --profile datatable",
    "cucumber:headed": "HEADED=1 cucumber-js",
    "report:cucumber": "start \"\" tta-report/cucumber/index.html"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@faker-js/faker": "^10.5.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "allure-playwright": "^3.10.2",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.4.2",
    "jsonpath-plus": "^10.4.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15",
    "winston": "^3.19.0",
    "xlsx": "^0.18.5"
  }
}
